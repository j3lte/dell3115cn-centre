[Unit]
Description=Refresh Dell 3115cn supply levels in CUPS (no page is printed)
After=cups.service
Requires=cups.service

[Service]
Type=oneshot
# The dell3115cn backend recognises the title "supply-refresh" and sends nothing to the printer.
Environment=QUEUE=Dell_MFP_Laser_3115cn
EnvironmentFile=-/etc/default/dell3115cn-supplies
ExecStart=/bin/sh -c 'printf "\\n" | /usr/bin/lp -d "$QUEUE" -t supply-refresh -o raw -'
